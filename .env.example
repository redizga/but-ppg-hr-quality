# Copy to .env and fill in. .env is gitignored — never commit your real token.

# Hugging Face token (scope: read) — needed to download the gated Llama used by
# OpenTSLM. Request access first: huggingface.co/meta-llama/Llama-3.2-3B
HF_TOKEN=

# Optional: where HF caches downloaded model weights (default: ~/.cache/huggingface).
# HF_HOME=/path/to/big/disk/huggingface
